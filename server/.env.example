NODE_ENV=development
PORT=4000
# Paste the NEW cluster URI from Atlas, with /bistro_bliss before the query string.
MONGODB_URI=
# Generate independently: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
# Used only for repository image URLs; set to the backend HTTPS origin on Vercel.
PUBLIC_API_URL=http://localhost:4000
# Required for password reset email (Gmail app password, not your login password).
NODEMAILER_USER=
NODEMAILER_PASSWORD=
# Required for new menu/profile uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
