extends baseEmail

block content
  // Add logo image here

  // Email content
  div(style='background-color: #AD343E; border-radius: 35px; padding: 3rem; color: #fff;')
    img(src=logoUrl, alt='Bistro Bliss', width='231', height='55', style='display: block; width:231px; max-width:100%; height:auto; margin:0 auto 32px auto;')
    p(style='font-size: 16px; color: #fff;') Hi #{firstName},
    p(style='font-size: 16px; color: #fff;') We received a request to reset your Bistro Bliss password.
    p(style='font-size: 16px; color: #fff;') Use the button below to choose a new password. This link expires in 10 minutes and can be used once.
    a(href=url, class="btn btn-primary", target='_blank', style='color: #fff; text-decoration: none; margin: 16px 0; background-color: #2C2F24; padding: 10px 20px; border-radius: 5px; transition: background-color 0.3s;  font-weight:bold; display:block; width:fit-content;') Reset your password
    p(style='font-size: 16px; color: #fff; font-weight: bold;') If you did not request this reset, you can ignore this email. Your password will remain unchanged.
